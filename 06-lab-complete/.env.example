# Copy: cp .env.example .env   (.env nằm trong .gitignore — KHÔNG commit)
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret: đặt giá trị thật bằng biến môi trường trên platform (Railway/Render)
AGENT_API_KEY=change-me

# docker compose tự đặt redis://redis:6379/0; chạy local ngoài Docker dùng localhost
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
